{
  "name": "@torimi/tsubame-browser-host",
  "version": "0.1.0",
  "description": "Tsubame browser App host — DOM/Hayate target selection and browser resource lifetime",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/KenichiroMatsubara/HayateProjects"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node -e \"process.env.GITHUB_ACTIONS||(console.error('publish only via the release workflow (ADR-0007 §4)'),process.exit(1))\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@torimi/hayate-host": "workspace:*",
    "@torimi/tsubame-app": "workspace:*",
    "@torimi/tsubame-renderer-dom": "workspace:*",
    "@torimi/tsubame-renderer-hayate": "workspace:*",
    "@torimi/tsubame-renderer-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "happy-dom": "^20.11.0",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.10"
  }
}
