{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hayateprojects.dev/torimi/wire-vocabulary.schema.json",
  "type": "object",
  "required": ["routes", "messages", "globals", "properties", "vocabularies"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "routes": { "$ref": "#/$defs/stringMap" },
    "messages": { "$ref": "#/$defs/stringMap" },
    "globals": { "$ref": "#/$defs/stringMap" },
    "properties": { "$ref": "#/$defs/stringMap" },
    "vocabularies": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/vocabulary" }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "vocabulary": {
      "type": "object",
      "required": ["compatibility", "values"],
      "additionalProperties": false,
      "properties": {
        "compatibility": { "enum": ["open", "closed"] },
        "values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
