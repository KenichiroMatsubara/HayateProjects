{
  "name": "@torimi/wire-contract",
  "version": "0.1.0",
  "description": "Torimi の transport・language 中立な wire facts と generated TypeScript projection（ADR-0006）。",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/KenichiroMatsubara/HayateProjects" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "spec", "fixtures"],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "prepublishOnly": "node -e \"process.env.GITHUB_ACTIONS||(console.error('publish only via the release workflow (ADR-0007 §4)'),process.exit(1))\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "vitest": "^4.1.10"
  }
}
